[
  {
    "description": "设置关卡视口摄像机的位置和旋转。",
    "name": "EditorToolset.EditorAppToolset.SetCameraTransform",
    "inputSchema": {
      "type": "object",
      "properties": {
        "transform": {
          "type": "object",
          "title": "ToolsetTransform",
          "description": "表示带有可选位置、旋转和缩放的3D变换。\n未设置的字段在创建Object时表示“使用默认/恒等值”，在修改现有Object时表示“保持不变”。",
          "properties": {
            "location": {
              "description": "世界空间位置。",
              "title": "Vector",
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            },
            "rotation": {
              "description": "世界空间旋转。",
              "title": "Rotator",
              "type": "object",
              "properties": {
                "pitch": {
                  "type": "number",
                  "description": "绕Y轴的Pitch（角度）"
                },
                "yaw": {
                  "type": "number",
                  "description": "绕Z轴的Yaw（角度）"
                },
                "roll": {
                  "type": "number",
                  "description": "绕X轴的Roll（角度）"
                }
              },
              "required": [
                "pitch",
                "yaw",
                "roll"
              ]
            },
            "scale": {
              "description": "缩放。",
              "title": "Vector",
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            }
          }
        }
      },
      "required": [
        "transform"
      ]
    }
  },
  {
    "description": "返回关卡视口摄像机的位置和旋转。",
    "name": "EditorToolset.EditorAppToolset.GetCameraTransform",
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
