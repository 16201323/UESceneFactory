      "properties": {
        "returnValue": {
          "type": "object",
          "title": "ToolsetTransform",
          "description": "返回关卡视口摄像机的变换。",
          "properties": {
            "location": {
              "description": "世界空间位置。",
              "title": "Vector",
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            },
            "rotation": {
              "description": "世界空间旋转。",
              "title": "Rotator",
              "type": "object",
              "properties": {
                "pitch": {
                  "type": "number",
                  "description": "绕Y轴的Pitch（角度）"
                },
                "yaw": {
                  "type": "number",
                  "description": "绕Z轴的Yaw（角度）"
                },
                "roll": {
                  "type": "number",
