                "roll"
              ]
            },
            "scale": {
              "description": "缩放。",
              "title": "Vector",
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
